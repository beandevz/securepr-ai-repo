SECUREPR_INGEST_SECRET=change_me

# There is no global GitHub token. Each repository supplies its own token when
# you connect it (POST /repos or the Connect Repository page); it is stored
# encrypted with TOKEN_ENCRYPTION_KEY. A relay may instead send the token in the
# X-SecurePR-Github-Token header.

# GitHub hosts SecurePR may talk to (comma-separated). Enterprise Server hosts
# use https://<host>/api/v3; github.com is always allowed and cannot be removed.
GITHUB_ALLOWED_HOSTS=github.com,github.boschdevcloud.com

# Processing test
QUEUE_PROVIDER=inproc  # inproc|azure_servicebus
INPROC_QUEUE_MAXSIZE=200
SERVICEBUS_CONNECTION_STRING=
SERVICEBUS_QUEUE_NAME=securepr

# LLM
LLM_PROVIDER=none  # none|openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Override for Azure OpenAI or a self-hosted OpenAI-compatible gateway.
# Leave empty to use api.openai.com.
OPENAI_BASE_URL=
LLM_TEMPERATURE=0
MAX_LLM_CHUNKS=5

# RAG
RAG_ENABLED=false
RAG_DB_PATH=rag.db
RAG_TOP_K=4
# Chunks scoring below this cosine similarity are dropped before the review
# prompt, so unrelated policy text never becomes "evidence".
RAG_MIN_SCORE=0.30
# Without an embedding model, embeddings fall back to SHA-256 hashes, which are
# not semantic — retrieval is skipped unless this is explicitly set to true.
RAG_ALLOW_LOCAL_EMBEDDINGS=false
# Longest retrieval query built from a file's added lines; larger patches are
# queried per hunk instead of being cut off.
RAG_QUERY_MAX_CHARS=4000
RAG_CHUNK_SIZE_CHARS=1200
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Review
MAX_INLINE_COMMENTS=12

# Check status reporting
STATUS_REPORTING_ENABLED=true
STATUS_REPORTING_MODE=check_run  # check_run|commit_status
STATUS_CHECK_NAME=SecurePR AI
STATUS_DETAILS_URL=

# Merge gating threshold (only affects conclusion)
MERGE_GATE_MIN_SEVERITY=HIGH

# Repo connections (Connect Repository page)
TOKEN_ENCRYPTION_KEY=change_me
PUBLIC_BASE_URL=
REPOS_DB_PATH=repos.db
JOBS_DB_PATH=jobs.db
