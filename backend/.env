SECUREPR_INGEST_SECRET=change_me
GITHUB_TOKEN=

# Processing
QUEUE_PROVIDER=inproc  # inproc|azure_servicebus
INPROC_QUEUE_MAXSIZE=200
SERVICEBUS_CONNECTION_STRING=
SERVICEBUS_QUEUE_NAME=securepr

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.4
LLM_TEMPERATURE=0
MAX_LLM_CHUNKS=5

# RAG
RAG_ENABLED=true
RAG_DB_PATH=rag.db
RAG_TOP_K=4
RAG_CHUNK_SIZE_CHARS=1200
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Review
MAX_INLINE_COMMENTS=12

# Check status reporting
STATUS_REPORTING_ENABLED=true
STATUS_REPORTING_MODE=check_run  # check_run|commit_status
STATUS_CHECK_NAME=SecurePR AI
STATUS_DETAILS_URL=

# Merge gating threshold (only affects conclusion)
MERGE_GATE_MIN_SEVERITY=HIGH
